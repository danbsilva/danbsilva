        }
      },
      "id": "search-kb",
      "name": "Buscar na Knowledge Base",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Zendesk HTTP Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Processar resultados da busca\nconst searchResults = $('Buscar na Knowledge Base').item.json.results || [];\nconst limit = parseInt($('Preparar Query').item.json.limit);\nconst query = $('Preparar Query').item.json.query;\n\n// Filtrar e formatar artigos\nconst articles = searchResults\n  .filter(article => article.result_type === 'article')\n  .slice(0, limit)\n  .map(article => ({\n    id: article.id,\n    title: article.title,\n    body: article.body || article.body_snippet || '',\n    url: article.html_url || `https://${$env.ZENDESK_BASE_URL.replace('https://', '').replace('http://', '')}/hc/articles/${article.id}`,\n    relevance: article.score || 0\n  }));\n\nreturn {\n  json: {\n    query: query,\n    articles: articles,\n    count: articles.length,\n    found: articles.length > 0\n  }\n};"
      },
      "id": "process-results",
      "name": "Processar Resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
