      "id": "prepare-escalation",
      "name": "Preparar Escalação",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1780, 500]
    },
    {
      "parameters": {
        "workflowId": "={{ $env.MODULO_ESCALACAO_WORKFLOW_ID }}",
        "source": {
          "id": "{{ $json }}",
          "name": "Dados para Escalação"
        }
      },
      "id": "exec-escalacao",
      "name": "Executar: Verificar Escalação",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [2000, 500],
      "webhookId": ""
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-escalated",
              "leftValue": "={{ $json.escalated }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-escalated",
      "name": "Verificar: Foi Escalado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2220, 500]
    },
    {
      "parameters": {
        "resource": "ticket",
        "operation": "update",
        "ticketId": "={{ $('Extrair Dados').item.json.ticketId }}",
        "comment": "={{ $('Executar: Gerar Resposta').item.json.response }}",
        "public": true,
        "authorId": "={{ $env.ZENDESK_AI_AGENT_ID }}"
      },
      "id": "send-response",
      "name": "Zendesk: Enviar Resposta",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "position": [2220, 300],
      "credentials": {
        "zendeskApi": {
          "id": "1",
          "name": "Zendesk API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log da execução\nconst executionLog = {\n  timestamp: new Date().toISOString(),\n  ticketId: $('Extrair Dados').item.json.ticketId,\n  channel: $('Extrair Dados').item.json.channel,\n  intent: $('Executar: Classificar Intenção').item.json.intent,\n  escalated: $('Executar: Verificar Escalação').item.json.escalated || false,\n  messagePreview: $('Extrair Dados').item.json.message.substring(0, 100),\n  responsePreview: $('Executar: Gerar Resposta').item.json.response.substring(0, 100)\n};\n\nconsole.log('Agente IA Modular - Execução:', JSON.stringify(executionLog, null, 2));\n\nreturn {\n  json: executionLog\n};"
      },
      "id": "log-execution",
      "name": "Log: Execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 400]
    }
