        "zendeskApi": {
          "id": "1",
          "name": "Zendesk API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ticket-id",
              "name": "ticketId",
              "value": "={{ $json.ticket_id }}",
              "type": "number"
            },
            {
              "id": "comment-id",
              "name": "commentId",
              "value": "={{ $json.id }}",
              "type": "number"
            },
            {
              "id": "comment-body",
              "name": "message",
              "value": "={{ $json.body }}",
              "type": "string"
            },
            {
              "id": "author-id",
              "name": "authorId",
              "value": "={{ $json.author_id }}",
              "type": "number"
            },
            {
              "id": "is-public",
              "name": "isPublic",
              "value": "={{ $json.public }}",
              "type": "boolean"
            },
            {
              "id": "channel",
              "name": "channel",
              "value": "={{ $json.channel || 'web' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-data",
      "name": "Extrair Dados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-is-public",
              "leftValue": "={{ $json.isPublic }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "check-not-bot",
              "leftValue": "={{ $json.authorId }}",
              "rightValue": "={{ $env.ZENDESK_AI_AGENT_ID }}",
              "operator": {
                "type": "number",
                "operation": "notEqual",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-valid",
      "name": "Filtrar: Comentário Válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "workflowId": "={{ $env.MODULO_BUSCAR_CONTEXTO_WORKFLOW_ID }}",
        "source": {
          "id": "{{ $json.ticketId }}",
          "name": "Ticket ID"
        }
      },
      "id": "exec-buscar-contexto",
      "name": "Executar: Buscar Contexto",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [900, 300],
      "webhookId": ""
    },
    {
      "parameters": {
        "assignments": {
