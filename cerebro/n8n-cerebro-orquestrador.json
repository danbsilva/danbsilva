      "position": [900, 600]
    },
    {
      "parameters": {
        "workflowId": "={{ $env.CEREBRO_ESCALACAO_WORKFLOW_ID }}",
        "source": {
          "id": "{{ $json }}",
          "name": "Dados para Escalação"
        },
        "options": {}
      },
      "id": "exec-escalation",
      "name": "Executar: Decisor de Escalação",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1120, 600],
      "webhookId": ""
    },
    {
      "parameters": {
        "jsCode": "// Combinar todas as decisões do cérebro\nconst classification = $('Executar: Classificador').item.json;\nconst response = $('Executar: Gerador de Resposta').item.json;\nconst escalation = $('Executar: Decisor de Escalação').item.json;\n\nconst brainOutput = {\n  success: true,\n  input: {\n    message: $('Preparar Entrada').item.json.message,\n    context: $('Preparar Entrada').item.json.context\n  },\n  classification: {\n    intent: classification.intent,\n    confidence: classification.confidence\n  },\n  response: {\n    text: response.response,\n    intent: response.intent\n  },\n  escalation: {\n    escalated: escalation.escalated,\n    priority: escalation.priority,\n    reason: escalation.reason\n  },\n  recommendation: escalation.escalated ? \n    `Escalar para humano: ${escalation.reason}` :\n    `Responder: ${response.response.substring(0, 100)}...`,\n  timestamp: new Date().toISOString()\n};\n\nreturn {\n  json: brainOutput\n};"
      },
      "id": "combine-brain",
      "name": "Combinar: Decisões do Cérebro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "jsCode": "// Saída formatada final\nconst brainDecision = $('Combinar: Decisões do Cérebro').item.json;\n\nconsole.log('\\n🧠 === DECISÃO DO CÉREBRO ===');\nconsole.log(`Mensagem: ${brainDecision.input.message}`);\nconsole.log(`Intenção: ${brainDecision.classification.intent} (${brainDecision.classification.confidence})`);\nconsole.log(`Escalado: ${brainDecision.escalation.escalated ? 'SIM' : 'NÃO'}`);\nif (brainDecision.escalation.escalated) {\n  console.log(`Prioridade: ${brainDecision.escalation.priority}`);\n  console.log(`Razão: ${brainDecision.escalation.reason}`);\n} else {\n  console.log(`Resposta: ${brainDecision.response.text.substring(0, 150)}...`);\n}\nconsole.log('=============================\\n');\n\nreturn {\n  json: {\n    success: true,\n    ...brainDecision\n  }\n};"
      },
      "id": "format-output",
      "name": "Formatar: Saída Final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 400]
    }
