# ============================================
# Configuração - Agente IA Zendesk
# ============================================
# Copie este arquivo e preencha com seus valores reais
# Configure essas variáveis no n8n: Settings → Environment Variables

# ============================================
# ZENDESK CONFIGURATION
# ============================================

# URL base do seu Zendesk (sem /api/v2)
# Exemplo: https://sua-empresa.zendesk.com
ZENDESK_BASE_URL=https://sua-empresa.zendesk.com

# ID do usuário que representa o Agente IA no Zendesk
# Como obter:
#   1. No Zendesk, crie um usuário para o bot (ex: "LIA - Agente Virtual")
#   2. Vá em Admin → Team → Agents
#   3. Clique no usuário e copie o User ID da URL
# Exemplo: 123456789
ZENDESK_AI_AGENT_ID=123456789

# ID do Grupo de Agentes Humanos (para escalação)
# Como obter:
#   1. No Zendesk, vá em Admin → Team → Groups
#   2. Selecione ou crie o grupo de atendimento humano
#   3. Copie o Group ID da URL
# Exemplo: 987654321
ZENDESK_HUMAN_AGENT_GROUP_ID=987654321

# ============================================
# ZENDESK API CREDENTIALS
# ============================================
# Configure essas no n8n como credenciais, não como variáveis de ambiente

# Zendesk Subdomain (para credencial Zendesk API)
# Exemplo: sua-empresa
ZENDESK_SUBDOMAIN=sua-empresa

# Zendesk Email (para credencial Zendesk API)
# Exemplo: suporte@exemplo.com
ZENDESK_EMAIL=seu-email@exemplo.com

# Zendesk API Token (para credencial Zendesk API)
# Como obter:
#   1. Zendesk → Admin → Apps and integrations → APIs → Zendesk API
#   2. Clique em "Add API token"
#   3. Copie o token gerado
# IMPORTANTE: Configure isso como credencial no n8n, não aqui!
ZENDESK_API_TOKEN=seu_token_aqui

# ============================================
# OPENAI CONFIGURATION
# ============================================

# OpenAI API Key
# Como obter:
#   1. Acesse https://platform.openai.com/api-keys
#   2. Crie uma nova API key
#   3. Copie e configure como credencial no n8n
# IMPORTANTE: Configure isso como credencial no n8n, não aqui!
OPENAI_API_KEY=sk-...

# Modelo a ser usado (opcional, padrão é gpt-4)
# Opções: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# Recomendado para produção: gpt-3.5-turbo (mais rápido e barato)
OPENAI_MODEL=gpt-4

# ============================================
# CONFIGURAÇÕES AVANÇADAS (Opcional)
# ============================================

# Temperatura para geração de respostas (0.0 - 2.0)
# Valores mais baixos = mais determinístico
# Valores mais altos = mais criativo
# Padrão: 0.7
OPENAI_TEMPERATURE=0.7

# Máximo de tokens na resposta
# Padrão: 2000
OPENAI_MAX_TOKENS=2000

# Número de mensagens do histórico a considerar
# Padrão: 10
CONVERSATION_HISTORY_LIMIT=10

# Habilitar escalação automática
# true = habilita, false = desabilita
# Padrão: true
ENABLE_AUTO_ESCALATION=true

# ============================================
# WEBHOOK CONFIGURATION
# ============================================

# URL pública do seu n8n (para webhooks do Zendesk)
# Exemplo: https://seu-n8n.exemplo.com
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA compartilhe este arquivo com tokens/credenciais reais
# 2. Configure credenciais sensíveis no n8n, não como variáveis de ambiente
# 3. Use variáveis de ambiente apenas para IDs e configurações não-sensíveis
# 4. Revise todas as configurações antes de ativar o workflow em produção
#
# ============================================
